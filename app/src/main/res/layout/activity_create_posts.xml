<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".post_feed.CreatePostsActivity"
    android:background="@color/backgroundUniverse">
    <include layout="@layout/activity_actionbar"></include>
    <include layout="@layout/activity_navbar"></include>

    <LinearLayout
        android:id="@+id/images_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center"
        android:layout_marginTop="85dp"
        android:orientation="vertical"
        android:visibility="visible">

        <androidx.cardview.widget.CardView
            android:layout_width="300dp"
            android:layout_height="300dp"
            app:cardCornerRadius="20dp">
            <ImageView
                android:id="@+id/photo_post"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_foto_update"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_photo"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="Añadir Foto" />

        </LinearLayout>

        <EditText
            android:id="@+id/name_product_post"
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:autofillHints="name"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/white"
            android:hint="Nombre del Producto:"
            android:inputType="text"
            android:textColor="@color/white" />
        <LinearLayout
            android:id="@+id/linearLayout_price_category"
            android:layout_width="370dp"
            android:layout_height="50dp">
            <EditText
                android:id="@+id/price_product_post"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/white"
                android:textColorHint="@color/white"
                android:hint="Precio:"
                android:inputType="text"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/multispinner_category"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="0dp"
                android:backgroundTint="@color/white"
                android:textColorHint="@color/white"
                android:hint="Categoria:"
                android:inputType="text"
                android:textColor="@color/white" />
        </LinearLayout>

        <EditText
            android:id="@+id/descrip_product_post"
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:autofillHints="name"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/white"
            android:hint="Descripcion:"
            android:inputType="textMultiLine"
            android:textColor="@color/white"
            android:maxEms="250"
            android:scrollbarAlwaysDrawVerticalTrack="true"/>

        <EditText
            android:id="@+id/location_product_post"
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:autofillHints="name"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/white"
            android:hint="Ubicacion:"
            android:inputType="text"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/stock_product_post"
            android:layout_width="370dp"
            android:layout_height="48dp"
            android:autofillHints="name"
            android:backgroundTint="@color/white"
            android:textColorHint="@color/white"
            android:hint="Cant. Producto:"
            android:inputType="number"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btn_add"
            android:layout_width="250dp"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="PUBLICAR"
            android:textSize="25sp" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>