<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilActivity"
    android:background="@color/backgroundUniverse">
    <include layout="@layout/activity_actionbar"></include>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="50dp"
        android:background="@color/perfil">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:cardCornerRadius="100dp">
                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:srcCompat="@drawable/ic_photo_perfil"
                    />
            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp">
                <TextView
                    android:layout_width="220dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/gray"
                    android:text="Username"
                    android:textSize="18sp"
                    />
                <TextView
                    android:id="@+id/userNameDEditText"
                    android:layout_width="220dp"
                    android:layout_height="45dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="5dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:text="USER"/>
                <TextView
                    android:layout_width="220dp"
                    android:layout_height="20dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/gray"
                    android:text="Nombre completo"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/fullNameDEditText"
                    android:layout_width="220dp"
                    android:layout_height="45dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="5dp"
                    android:textSize="19sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:text="Nombre Usuario"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="360dp"
            android:layout_height="25dp"
            android:layout_marginTop="15dp"
            android:paddingStart="15dp"
            android:textColor="@color/gray"
            android:text="Contacto"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/gray"
            android:text="Numero telefonico"
            android:textStyle="italic"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/phoneDEditText"
            android:layout_width="360dp"
            android:layout_height="25dp"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            android:textColor="@color/white"
            android:text="Telefono"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="360dp"
            android:layout_height="20dp"
            android:layout_marginTop="15dp"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            android:textColor="@color/gray"
            android:text="Correo Electronico"
            android:textStyle="italic"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/emailDEditText"
            android:layout_width="360dp"
            android:layout_height="25dp"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            android:textColor="@color/white"
            android:text="Email"
            android:textSize="20sp"/>

    </LinearLayout>


    <include layout="@layout/activity_navbar"></include>

</androidx.constraintlayout.widget.ConstraintLayout>